# ================= DATABASE CONFIGURATION =================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buildpro_db
ANALYTICS_DB_NAME=analytics_db
DB_URL=jdbc:mysql://localhost:3306/buildpro_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
MYSQL_JAR_PATH=C:\winutils\mysql-connector-j-8.3.0.jar
WINUTILS_DIR=C:\winutils

# ================= EMAIL CONFIGURATION =================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ================= GEMINI AI =================
GEMINI_API_KEY=your_gemini_api_key_here

# ================= RAZORPAY =================
RAZORPAY_KEY=your_razorpay_key_here
RAZORPAY_SECRET=your_razorpay_secret_here

# ================= Location & Swagger =================
API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_TAG_SORTER=alpha
SWAGGER_OPERATION_SORTER=alphacm
MAPBOX_TOKEN=your_mapbox_token_here

# ================= JWT SECURITY =================
JWT_SECRET=your_jwt_secret_key_here
